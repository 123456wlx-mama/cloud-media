set(CMAKE_CXX_STANDARD 11)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

add_library(cm_compile_options INTERFACE)

if(MSVC)
    target_compile_options(cm_compile_options INTERFACE /W4 /permissive-)
else()
    target_compile_options(cm_compile_options INTERFACE -Wall -Wextra -Wpedantic)
endif()

if(ENABLE_ASAN)
    if(MSVC)
        message(FATAL_ERROR "ENABLE_ASAN is not configured for MSVC in this project.")
    endif()
    target_compile_options(cm_compile_options INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(cm_compile_options INTERFACE -fsanitize=address,undefined)
endif()

if(ENABLE_TSAN)
    if(MSVC)
        message(FATAL_ERROR "ENABLE_TSAN is not configured for MSVC in this project.")
    endif()
    target_compile_options(cm_compile_options INTERFACE -fsanitize=thread -fno-omit-frame-pointer)
    target_link_options(cm_compile_options INTERFACE -fsanitize=thread)
endif()

if(ENABLE_COVERAGE)
    if(MSVC)
        message(FATAL_ERROR "ENABLE_COVERAGE is only configured for GCC/Clang.")
    endif()
    target_compile_options(cm_compile_options INTERFACE --coverage)
    target_link_options(cm_compile_options INTERFACE --coverage)
endif()
