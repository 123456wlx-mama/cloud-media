/* cloud-media 深色主题基线（P8-0）
   色板/字号/间距与 docs/specs/08-界面设计契约.md §4 一一对应，改色请先改契约。 */

QWidget {
    background-color: #12161B;
    color: #E6EDF5;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 19px;
}

QMainWindow, QDialog {
    background-color: #12161B;
}

/* ---------- 三段式 ---------- */
QSplitter#mainSplitter::handle {
    background-color: #2C3542;
}

#filePane, #transferPane, #playerPane {
    background-color: #1A2028;
}

#paneHeader {
    background-color: #1A2028;
    border-bottom: 1px solid #2C3542;
}

#paneTitle {
    color: #E6EDF5;
    font-size: 21px;
    font-weight: 600;
}

#emptyHint {
    color: #5C6879;
    font-size: 19px;
    line-height: 20px;
}

#mainStatusBar {
    background-color: #1A2028;
    border-top: 1px solid #2C3542;
    color: #9AA7B8;
    font-size: 21px;
}

/* 状态栏右侧的连接徽标 + 左下登录用户，单独放大（原来挤在状态栏里太小） */
#linkBadge {
    font-size: 21px;
    padding: 2px 10px;
}

QStatusBar QLabel {
    font-size: 21px;
}

/* 自绘输入框（新建文件夹等）：固定深色底，避免出现白框 */
QDialog#formDialog {
    background-color: #161C23;
}

/* ---------- 登录 ---------- */
#loginDialog {
    background-color: #1A2028;
}

#brandTitle {
    color: #E6EDF5;
    font-size: 26px;
    font-weight: 600;
}

#brandSubtitle {
    color: #9AA7B8;
    font-size: 19px;
    margin-top: 6px;
}

#telEdit, #passwordEdit {
    background-color: #222A34;
    border: 1px solid #2C3542;
    border-radius: 6px;
    padding: 10px 12px;
    color: #E6EDF5;
    font-size: 21px;
        selection-background-color: #3D8BFF;
}

#telEdit:focus, #passwordEdit:focus {
    border: 1px solid #3D8BFF;
}

#formError {
    color: #E5544B;
    font-size: 18px;
}

#primaryButton {
    background-color: #3D8BFF;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 600;
    padding: 10px 16px;
}

#primaryButton:hover {
    background-color: #5AA0FF;
}

#primaryButton:pressed {
    background-color: #2F73D9;
}

#primaryButton:disabled {
    background-color: #2C3542;
    color: #5C6879;
}

#linkButton {
    background: transparent;
    border: none;
    color: #3D8BFF;
    font-size: 19px;
    padding: 0 2px;
}

#linkButton:hover {
    color: #5AA0FF;
}

#hintText {
    color: #9AA7B8;
    font-size: 19px;
}

/* ---------- 通用控件占位（P8-1 起真正使用） ---------- */
QPushButton {
    background-color: #222A34;
    border: 1px solid #2C3542;
    border-radius: 6px;
    color: #E6EDF5;
    padding: 6px 14px;
}

QPushButton:hover {
    border-color: #3D8BFF;
}

QTableView, QListView, QTreeView {
    background-color: #1A2028;
    alternate-background-color: #1E252E;
    border: none;
    color: #E6EDF5;
    selection-background-color: #22344F;
    selection-color: #E6EDF5;
}

QHeaderView::section {
    background-color: #222A34;
    border: none;
    border-bottom: 1px solid #2C3542;
    color: #9AA7B8;
    padding: 6px 8px;
}

QProgressBar {
    background-color: #222A34;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #3D8BFF;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2C3542;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3A4553;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    background-color: #222A34;
    border: 1px solid #2C3542;
    color: #E6EDF5;
    padding: 4px 8px;
}

/* ---------- P8-3：面包屑 / 右键菜单 / Toast / 分享 / 回收站 ---------- */
#pathBar {
    background-color: #1A2028;
    border-bottom: 1px solid #2C3542;
}

#pathLabel {
    color: #E6EDF5;
    font-size: 19px;
    padding-left: 4px;
}

QPushButton#rowButton {
    background-color: #222A34;
    border: 1px solid #2C3542;
    border-radius: 6px;
    color: #E6EDF5;
    font-size: 18px;
    padding: 4px 10px;
}

QPushButton#rowButton:hover {
    border-color: #3D8BFF;
}

QPushButton#rowButton:disabled {
    color: #5C6879;
    border-color: #2C3542;
}

QPushButton#dangerButton {
    background-color: #222A34;
    border: 1px solid #E5544B;
    border-radius: 6px;
    color: #E5544B;
    padding: 6px 14px;
}

QPushButton#dangerButton:hover {
    background-color: #E5544B;
    color: #FFFFFF;
}

#taskName {
    color: #E6EDF5;
    font-size: 19px;
}

#taskState {
    color: #9AA7B8;
    font-size: 18px;
}

#taskStateInstant {
    color: #35C46B;
    font-size: 18px;
    font-weight: 600;
}

#taskError {
    color: #E5544B;
    font-size: 18px;
}

#recycleRow {
    background-color: #1A2028;
}

#toast {
    background-color: #222A34;
    border: 1px solid #2C3542;
    border-radius: 8px;
}

#toastText {
    color: #E6EDF5;
    font-size: 19px;
}

QPushButton#toastAction {
    background: transparent;
    border: none;
    color: #3D8BFF;
    font-size: 19px;
    font-weight: 600;
    padding: 0 4px;
}

QPushButton#toastAction:hover {
    color: #5AA0FF;
}

#shareCode {
    color: #3D8BFF;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 4px;
    padding: 12px 0;
}

QMenu {
    background-color: #222A34;
    border: 1px solid #2C3542;
    color: #E6EDF5;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #22344F;
}

QMenu::item:disabled {
    color: #5C6879;
}


/* ---------- P8-4：播放区 ---------- */
#playerPane {
    background-color: #12161B;
}

#playerControls {
    background-color: #1A2028;
    border-top: 1px solid #2C3542;
}

QPushButton#playButton {
    background-color: #222A34;
    border: 1px solid #2C3542;
    border-radius: 14px;
    color: #E6EDF5;
    font-size: 21px;
}

QPushButton#playButton:hover {
    border-color: #3D8BFF;
}

QSlider::groove:horizontal {
    background: #222A34;
    border-radius: 3px;
    height: 6px;
}

QSlider::sub-page:horizontal {
    background: #3D8BFF;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #E6EDF5;
    border-radius: 6px;
    width: 12px;
    margin: -4px 0;
}

QSlider::handle:horizontal:hover {
    background: #5AA0FF;
}

#playerOverlay {
    background-color: #1A2028;
    border: 1px solid #2C3542;
    border-radius: 8px;
}

#bufferLabel {
    color: #E6EDF5;
    font-size: 19px;
}

#playerErrorPanel {
    background-color: #1A2028;
    border: 1px solid #2C3542;
    border-radius: 8px;
}

/* 传输区「上传/下载」页签：之前没写样式，Qt 默认白底白字 → 一片白框看不清 */
QTabWidget::pane {
    background-color: #1A2028;
    border: 1px solid #2C3542;
    border-radius: 6px;
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #222A34;
    color: #9AA7B8;
    min-width: 56px;
    padding: 5px 8px;
    border: 1px solid #2C3542;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #1A2028;
    color: #E6EDF5;
    border-bottom: 2px solid #3D8BFF;
}

QTabBar::tab:hover {
    color: #E6EDF5;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

